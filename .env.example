# Required
BOT_TOKEN=123456789:replace-with-botfather-token
ADMIN_ID=123456789

# Optional. If configured, the bot must be an administrator in this channel.
CHANNEL_ID=@your_channel

# Required for the AI assistant feature.
GEMINI_API_KEY=replace-with-google-gemini-key
# Optional: Gemini model id (check Google AI Studio). Change here if Google retires the model.
GEMINI_MODEL=gemini-3.5-flash
# Optional: AI requests per user per day (admin is unlimited).
AI_DAILY_LIMIT=30

# Public HTTPS URL used by the Telegram Web App.
RENDER_URL=https://your-public-domain.example
PORT=10000
# Optional: bot username is read from Telegram automatically (this is only a fallback).
# BOT_USERNAME=raqamli_ofis_bot

# Optional: bot interface alphabet. "new" (default) = yangi lotin (ó, ǵ, ş, ç, ñ), "old" = hozirgi lotin.
# BOT_ALPHABET=new

# Signed Telegram Web App initData lifetime.
WEBAPP_INIT_DATA_MAX_AGE=86400

# Optional but recommended on Render: persistent PostgreSQL (e.g. Neon free tier).
# Without it the bot uses a local SQLite file, which Render wipes on every deploy.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
